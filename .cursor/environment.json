{
  "name": "Placcera Placement Tracker",
  "user": "node",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "install": "./scripts/cloud-agent-install.sh",
  "start": "./scripts/cloud-agent-start.sh",
  "ports": [
    {
      "name": "frontend",
      "port": 3000
    },
    {
      "name": "api",
      "port": 5000
    }
  ],
  "terminals": [
    {
      "name": "backend",
      "command": "npm start --prefix backend",
      "description": "Express API on port 5000"
    },
    {
      "name": "frontend",
      "command": "npm start --prefix placement_tracker",
      "description": "React dev server on port 3000"
    }
  ]
}
