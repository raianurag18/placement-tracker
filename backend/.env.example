# Copy this file to .env and fill in real values.
# Never commit .env — hosts (Render/Railway) set these in the dashboard.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/placerra

# Long random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin(s). Comma-separated if you have preview + production URLs.
# Example: https://placerra.vercel.app,https://placerra-git-main.vercel.app
CLIENT_URL=http://localhost:3000

# Optional — only for local demo seed scripts (utils/seedTestTenants.js), not the API server
# ADMIN_PASSWORD=admin123
# STUDENT_PASSWORD=student123
